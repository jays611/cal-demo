datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(MEMBER)
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  bookings  Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  members   User[]
  bookings  Booking[]
  createdAt DateTime @default(now())
}

model Booking {
  id          String        @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus @default(CONFIRMED)
  visibility  Visibility    @default(PUBLIC)
  recurring   Boolean       @default(false)
  recurrenceRule String?
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  teamId      String?
  team        Team?         @relation(fields: [teamId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum Role {
  ADMIN
  MEMBER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  PENDING
}

enum Visibility {
  PUBLIC
  PRIVATE
  TEAM_ONLY
}
